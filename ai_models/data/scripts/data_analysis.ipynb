# Import necessary libraries
import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import re
from collections import Counter
from wordcloud import WordCloud
%matplotlib inline

# Set display options
pd.set_option('display.max_colwidth', None)
sns.set(style='whitegrid')

# Define file paths
processed_data_dir = os.path.join('..', '..', 'data', 'processed')
training_data_path = os.path.join(processed_data_dir, 'training_data.parquet')
validation_data_path = os.path.join(processed_data_dir, 'validation_data.parquet')
test_data_path = os.path.join(processed_data_dir, 'test_data.parquet')

# Load datasets
train_df = pd.read_parquet(training_data_path)
val_df = pd.read_parquet(validation_data_path)
test_df = pd.read_parquet(test_data_path)

print("Datasets loaded successfully.")

# Display the first few rows of the training data
display(train_df.head())

# Print the sizes of each dataset
print(f"Training set size: {len(train_df)}")
print(f"Validation set size: {len(val_df)}")
print(f"Test set size: {len(test_df)}")

# Add columns for the length of prompts and responses
train_df['prompt_length'] = train_df['prompt'].apply(len)
train_df['response_length'] = train_df['response'].apply(len)

# Statistical summary of prompt lengths
print("Prompt Length Statistics:")
print(train_df['prompt_length'].describe())

# Statistical summary of response lengths
print("\nResponse Length Statistics:")
print(train_df['response_length'].describe())

# Histogram of prompt lengths
plt.figure(figsize=(10, 6))
sns.histplot(train_df['prompt_length'], bins=50, kde=True)
plt.title('Distribution of Prompt Lengths')
plt.xlabel('Length of Prompts (characters)')
plt.ylabel('Frequency')
plt.show()

# Histogram of response lengths
plt.figure(figsize=(10, 6))
sns.histplot(train_df['response_length'], bins=50, kde=True, color='orange')
plt.title('Distribution of Response Lengths')
plt.xlabel('Length of Responses (characters)')
plt.ylabel('Frequency')
plt.show()

# Function to tokenize text
def tokenize(text):
    text = re.sub(r'[^a-zA-Z\s]', '', text)  # Remove punctuation
    tokens = text.lower().split()
    return tokens

# Combine all prompts into one string
all_prompts = ' '.join(train_df['prompt'].tolist())
prompt_tokens = tokenize(all_prompts)

# Get the most common words in prompts
prompt_word_counts = Counter(prompt_tokens)
common_prompt_words = prompt_word_counts.most_common(20)
print("Most Common Words in Prompts:")
for word, count in common_prompt_words:
    print(f"{word}: {count}")

# Combine all responses into one string
all_responses = ' '.join(train_df['response'].tolist())
response_tokens = tokenize(all_responses)

# Get the most common words in responses
response_word_counts = Counter(response_tokens)
common_response_words = response_word_counts.most_common(20)
print("Most Common Words in Responses:")
for word, count in common_response_words:
    print(f"{word}: {count}")

# Generate word cloud for prompts
prompt_wordcloud = WordCloud(width=800, height=400, background_color='white').generate(' '.join(prompt_tokens))

# Display the word cloud
plt.figure(figsize=(15, 7.5))
plt.imshow(prompt_wordcloud, interpolation='bilinear')
plt.axis('off')
plt.title('Word Cloud of Prompts')
plt.show()

# Generate word cloud for responses
response_wordcloud = WordCloud(width=800, height=400, background_color='white').generate(' '.join(response_tokens))

# Display the word cloud
plt.figure(figsize=(15, 7.5))
plt.imshow(response_wordcloud, interpolation='bilinear')
plt.axis('off')
plt.title('Word Cloud of Responses')
plt.show()

# Check for null values in training data
print("Null values in training data:")
print(train_df.isnull().sum())

# Check for duplicates in training data
duplicate_count = train_df.duplicated(subset=['prompt', 'response']).sum()
print(f"Number of duplicate rows in training data: {duplicate_count}")

# Number of unique prompts
unique_prompts = train_df['prompt'].nunique()
print(f"Number of unique prompts: {unique_prompts}")

# Number of unique prompt-response pairs
unique_pairs = train_df.drop_duplicates(subset=['prompt', 'response']).shape[0]
print(f"Number of unique prompt-response pairs: {unique_pairs}")

# Scatter plot of prompt length vs. response length
plt.figure(figsize=(10, 6))
sns.scatterplot(x='prompt_length', y='response_length', data=train_df, alpha=0.5)
plt.title('Prompt Length vs. Response Length')
plt.xlabel('Prompt Length (characters)')
plt.ylabel('Response Length (characters)')
plt.show()


